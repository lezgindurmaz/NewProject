<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.joker.cargame.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/prankLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="20dp">

        <TextView
            android:id="@+id/prankTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SİSTEM KRİTİK HATASI"
            android:textColor="#FF0000"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/prankMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cihazınız kalıcı olarak izlenmeye başlandı.\nTüm verileriniz uzak sunucuya aktarılıyor..."
            android:textColor="#00FF00"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:gravity="center" />

        <ProgressBar
            android:id="@+id/prankProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:progress="0"
            android:max="100" />

        <TextView
            android:id="@+id/prankStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Dosyalar şifreleniyor: 0%"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="200dp"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"
            android:visibility="invisible">

            <SurfaceView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/targetDetected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HEDEF TESPİT EDİLDİ"
                android:textColor="#FF0000"
                android:background="#66000000"
                android:gravity="center"
                android:padding="5dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="bottom" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/scanner_line" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
