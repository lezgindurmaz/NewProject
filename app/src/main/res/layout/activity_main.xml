<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DroidSU Manager"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/patchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patch Boot Image"/>

    <Button
        android:id="@+id/installModulesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Install Bundled Modules"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Included Modules: Zygisk Next, LSPosed, Integrity Box, etc."
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:gravity="center"/>

</LinearLayout>
